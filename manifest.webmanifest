{
  "name": "Mujic",
  "short_name": "Mujic",
  "description": "Free music player: play your library offline or stream songs with synced lyrics, equalizer, queue and Picture-in-Picture.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "./",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "music",
    "entertainment",
    "multimedia"
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "url": "./?source=shortcut#search",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Library",
      "short_name": "Library",
      "url": "./?source=shortcut#library",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}